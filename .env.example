# Copy to .env and set your own credentials before starting the database.
# DATABASE_URL format: postgresql://atlas:<URL-encoded password>@127.0.0.1:55432/atlas
# POSTGRES_PASSWORD must be the matching unencoded password.
DATABASE_URL=
POSTGRES_PASSWORD=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Production also requires ATLAS_ENV=production, DJANGO_SECRET_KEY,
# real allowed hosts, HTTPS, and a PostgreSQL application role without superuser privileges.
